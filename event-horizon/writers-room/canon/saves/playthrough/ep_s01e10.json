  "log": [
    {
      "choice": "Jules is packing for Ravenscourt. Her door is open. Go in.",
      "ep": "s01e10",
      "hub": true,
      "scene": "a1_hub",
      "t": 1791924746609
    },
    {
      "choice": "Vinnie's been texting you *call me* since Monday. Call him.",
      "ep": "s01e10",
      "hub": true,
      "scene": "a1_hub",
      "t": 1791924784342
    },
    {
      "choice": "Call Mikey first. Tell him something's going to happen on the Parkway. Don't tell him how you know.",
      "ep": "s01e10",
      "scene": "a2_morning",
      "t": 1791924821590
    },
    {
      "choice": "Leave it on the hook. Hood up. Nobody's face. Nobody's hat.",
      "ep": "s01e10",
      "scene": "a2_cap",
      "t": 1791924843322
    },
    {
      "choice": "Look closer. What are they carrying? What are they watching?",
      "ep": "s01e10",
      "roll": {
