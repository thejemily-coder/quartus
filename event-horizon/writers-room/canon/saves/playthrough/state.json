      },
      {
        "choice": "Grab the fridge. \"I got it. I'm going up anyway.\" Don't wait for an answer.",
        "ep": "s01e01",
        "scene": "a1_arrive",
        "t": 1791842232624
      },
      {
        "choice": "Steady pace. Breathe. Don't die.",
