  "id": "s02e06",
  "log": [
    {
      "choice": "Ma. She's called four times. You've answered once. Go home for dinner on Tuesday.",
      "ep": "s02e06",
      "hub": true,
      "scene": "a1_ninety",
      "t": 1792007632001
    },
    {
      "choice": "\"Yeah, Ma. I knew him.\" And nothing else. Let her have that much of the truth.",
      "ep": "s02e06",
      "scene": "a1_ma",
      "t": 1792007641242
    },
    {
      "choice": "Bree. Edgemont Street. You haven't been back since Saturday morning. You're afraid to go. Go.",
      "ep": "s02e06",
      "hub": true,
      "scene": "a1_ninety",
      "t": 1792007655308
    },
    {
      "choice": "The truth. \"He didn't. He talked about your aunt. He talked about the money. Then he said *listen*, and that was all.\"",
      "ep": "s02e06",
      "scene": "a1_bree",
      "t": 1792007702264
    },
    {
      "choice": "Tell him. All of it. Eight floors, two stairs, the glass room, the beds. Halcyon killed Teddy. Let Bruno do what Bruno does.",
      "ep": "s02e06",
      "scene": "a2_bruno",
      "t": 1792007740722
    },
    {
      "choice": "\"My girlfriend.\" It's true. Say it like it's nothing.",
      "ep": "s02e06",
      "scene": "a2_car",
      "t": 1792007787773
    },
    {
      "choice": "Pull her up and skate with her. Straight. Just your legs and hers and the ice. No luck, no Slip, nothing.",
      "ep": "s02e06",
      "roll": {
        "dice": [
          6,
          3
        ],
        "kind": "move",
        "label": "Keep you both up",
        "nudged": false,
        "rewound": false,
        "tier": "strong"
      },
      "scene": "a3_rink",
      "t": 1792007859053
    },
    {
      "choice": "Give her the card. The last thing. \"He wrote this. In my handwriting. Before I ever knew what you were.\"",
      "ep": "s02e06",
      "scene": "a3_walk",
      "t": 1792007920774
    },
    {
      "choice": "Go in.",
      "ep": "s02e06",
      "scene": "a3_door",
      "t": 1792007977071
    },
    {
      "choice": "Show her the phone. All of it. Whatever it is, it's both of yours now.",
      "ep": "s02e06",
      "scene": "a4_sunday",
      "t": 1792008054208
    }
  ],
