        "tier": "strong"
      },
      "scene": "a2_ma",
      "t": 1791868184032
    },
    {
      "choice": "Temple University Hospital. Sixth floor. Carmen Torres. You owe her this.",
      "ep": "s01e02",
      "hub": true,
      "scene": "a2_hub",
      "t": 1791868230231
    },
    {
      "choice": "\"I'm sorry. I should've been faster. I should have gotten you too.\"",
      "ep": "s01e02",
      "scene": "a2_carmen",
      "t": 1791868253795
    },
    {
      "choice": "Vinnie's been blowing up your phone since the Wawa video. FaceTime him.",
      "ep": "s01e02",
      "hub": true,
      "scene": "a2_hub",
      "t": 1791868295712
    },
    {
      "choice": "\"What young guy? Vin. Who was Pop with?\"",
      "ep": "s01e02",
      "roll": {
