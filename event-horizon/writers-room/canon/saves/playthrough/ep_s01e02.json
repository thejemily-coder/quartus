  "log": [
    {
      "choice": "Tell him. All of it. The light, the bus, the cold, the kid. Carmen. Everything.",
      "ep": "s01e02",
      "scene": "cold_open",
      "t": 1791867773187
    },
    {
      "choice": "\"This isn't a comic, man. A woman's in the hospital because I wasn't fast enough.\" (But let him in.)",
      "ep": "s01e02",
      "scene": "cold_tell",
      "t": 1791867795795
    },
    {
      "choice": "Let her drive. She clearly knows this. Ask good questions.",
      "ep": "s01e02",
      "roll": {
        "dice": [
          2
        ],
        "kind": "d20",
        "label": "Worksheet 1: limits",
        "nudged": false,
        "rewound": false,
        "tier": "fail"
      },
      "scene": "a1_recitation",
      "t": 1791867891715
    },
    {
      "choice": "\"You're not crazy. I don't know what it is. But I can see you fine. Here, give me your number.\"",
      "ep": "s01e02",
      "scene": "a1_femi",
      "t": 1791868000454
    },
    {
      "choice": "\"Thank you. Seriously.\" Tell her the truth, or some of it: you were in the zone, it was cold, it's been weird since.",
      "ep": "s01e02",
      "roll": {
        "dice": [
          3,
          5
        ],
        "kind": "move",
        "label": "Trust Grace",
        "nudged": false,
        "rewound": false,
        "tier": "weak"
      },
      "scene": "a1_grace",
      "t": 1791868107281
    },
    {
      "choice": "Sleep. Actually sleep. Phone across the room.",
      "ep": "s01e02",
      "scene": "a1_grace_end",
      "t": 1791868142555
    },
    {
      "choice": "Call Ma back. It's been three days. She's called eleven times.",
      "ep": "s01e02",
      "hub": true,
      "scene": "a2_hub",
      "t": 1791868163463
    },
    {
      "choice": "\"Ma, everybody in Philly has my walk. It's a Philly walk.\" Make her laugh.",
      "ep": "s01e02",
      "roll": {
        "dice": [
          5,
          5
        ],
        "kind": "move",
        "label": "Disarm Ma",
        "nudged": false,
