{
  "id": "S2E13",
  "season": 2,
  "episode": 13,
  "showTitle": "The Hard Saying",
  "title": "Who Dat",
  "dates": "Sunday, February 7 – Monday, February 8, 2010",
  "logline": "Super Bowl Sunday on Dupre Street: the eight o’clock Mass in a family’s pew, a phone that rings at the kickoff, a kick nobody in the room can watch, and a city that has waited forty-three seasons to go outside.",
  "previously": [
    {
      "text": "In the darkroom, Skye: “And Sunday you’re going to want to go up, in some church in New Orleans I’ll never see. I want you to be able to.”",
      "if": "skye_told_morning"
    },
    {
      "text": "Past Picacho, Lena: “You always did read a margin well.”"
    },
    {
      "text": "Past Lordsburg, you: “Sorry, I forgot how private you and Julian are. When she stars in a movie called ‘Jack’ I’ll make sure you come watch the whole thing next to me so we can see your face enjoying how authentic and humble everything is.”"
    },
    {
      "text": "Short of Van Horn, Lena: “Quarter tank.”"
    },
    {
      "text": "On the Broussards’ front steps, Josie: “Who’s that?” — You: “My girlfriend,” … “In Canada.”",
      "if": "josie_asked"
    },
    {
      "text": "From the doorway, Mémère: “Y’all fight like married people.”",
      "if": "!josie_asked"
    },
    {
      "text": "On the phone, Skye: “You said you’d call at the kickoff,” … “I’m holding you to it.”",
      "if": "s2e11_goodbye==\"candor\""
    },
    {
      "text": "On the phone, Skye: “Tomorrow’s your game,” … “Call me at the kickoff. I’ll be in a trailer. I’ll be cheering for the wrong people, to keep it interesting.”",
      "if": "s2e11_goodbye!=\"candor\""
    }
  ],
