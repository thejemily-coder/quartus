 "title": "Fat Tuesday",
 "dates": "Monday, February 15 – Tuesday, February 16, 2010",
 "logline": "Lundi Gras and Mardi Gras: a king arrives by river, an old friend waits on the levee, the whole house wears paper bags with eyeholes, somebody else turns nineteen — and at midnight the horses come down Bourbon Street, and it’s Lent.",
 "previously": [
  {
   "text": "On I-10 over the high rise, Lena: “…What did I say?” — You: “That you wanted me here.” — Lena: “I did.”",
   "if": "s2e15_try==\"sincerity\""
  },
  {
   "text": "On I-10 over the high rise, Lena: “…What did I say?” — You: “You said Mama’ll kill me.” — Lena: “She will.”",
   "if": "s2e15_try==\"wit\""
  },
  {
   "text": "On I-10 over the high rise, Lena: “…What did I say?” — You: “Nothing. Go back to sleep.” — Lena: “Okay.”",
   "if": "s2e15_try!=\"sincerity\" && s2e15_try!=\"wit\""
  },
  {
   "text": "On the back steps, Lena: “Thank you for coming.”"
  },
  {
   "text": "On St. Charles Avenue, Skye: “Nobody sends me the first thing,” … “They send the last thing. Flowers after the premiere.”"
  },
  {
   "text": "In the attic, Kevin: “Tomorrow I’m nineteen.” — “It was Laney’s day.”",
   "if": "kevin_birthday_known"
  },
  {
   "text": "In your father’s garage, Lena: “Will you be around after? Monday night. Nine, ten.” — You: “Probably not,” … “I’ve got a thing.” — Lena: “Okay,” … “Then call me after. Eat something first.”"
  },
  {
   "text": "On Christmas Eve, on the phone from the levee at Lutcher, You: “I wish I was standing next to you.” — Lena: “Come stand on one sometime.”",
   "if": "s2e1_levee==\"unguarded\""
  }
 ],
