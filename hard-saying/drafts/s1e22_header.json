  "highlights": [
   {
    "if": "e1_lena_took_cig",
    "text": "On a back porch where you didn’t know anybody, a girl took the cigarette out of your mouth."
   },
   {
    "if": "e11_decided==\"wreck\"",
    "text": "On a motel porch above Lucia you told her you’d decided not to be the one who wrecks anything. “Me neither.”"
   },
   {
    "if": "becca_over",
    "text": "In Eli’s truck you told Becca you’re not right for her. She’d done everything right."
   },
   {
    "if": "theo_youngstown",
    "text": "You brought Theo home to Youngstown for Thanksgiving, and your father asked him to say grace."
   },
   {
    "if": "met_skye",
    "text": "At a party in Montecito you crossed the room yourself."
   },
   {
    "if": "lena_sometime",
    "text": "In a drugstore aisle she asked where you go. You said sometime."
   },
   {
    "if": "skye_first_no",
    "text": "On her bed on Del Playa you said no, and stayed till it got light."
   },
   {
    "if": "missed_saints_13",
    "text": "All of December you stayed away from her. On Gaudete Sunday you missed the Saints for the first time."
   },
   {
    "if": "skye_january && e22_skye==\"restraint\"",
    "text": "At one in the morning, in a car with no future, she said January. You told her to ask you again."
   },
   {
    "if": "skye_january && e22_skye!=\"restraint\"",
    "text": "At one in the morning, in a car with no future, you said yes to January."
   },
   {
    "if": "e22_roof==\"candor\"",
    "text": "On the roof, three nights before the longest night, you told her you had something to tell her, and didn’t get to."
   },
   {
    "if": "e22_roof==\"unguarded\"",
    "text": "On the roof, three nights before the longest night, you got one word into it, and stopped."
   },
   {
    "if": "e22_roof==\"sincerity\"",
    "text": "On the roof you told her it was the best night you’d had since — and neither of you finished."
   },
   {
    "if": "e22_roof==\"wit\"",
    "text": "On the roof you said you’d say something, but she’d grade it. She said she’d give it an A."
   },
   {
    "if": "e22_roof==\"restraint\"",
    "text": "On the roof you didn’t say it. She thanked you."
   }
  ]
 }
}