 "title": "The Darkroom",
 "dates": "Thursday, February 4 – Friday, February 5, 2010",
 "logline": "A grandmother in New Orleans picks up the phone, a professor names his price, seven seats get assigned in a parking lot without one direct word, and the last night before two people leave in opposite directions is spent in a room built for the dark.",
 "previously": [
  {
   "text": "On Lena’s phone, Mémère: “When you come to New Orleans, you come to this house first.”"
  },
  {
   "text": "In your room, Skye: “When I ask again,” … “I want you to have nowhere to be in the morning.”",
   "if": "skye_didnt_ask"
  },
  {
   "text": "In the lobby, Lena: “Mama says bring the redhead. Daddy says bring the Ohio boy.” … “I’m only telling you what he said.”",
   "if": "heard_ohio_boy"
  },
  {
   "text": "Behind the screen: “I want to. I’m closer than I’ve ever been to not wanting to.”",
   "if": "s2e10_amend==\"candor\""
  },
  {
   "text": "Behind the screen: “I’ll try.”",
   "if": "s2e10_amend==\"sincerity\""
  },
  {
   "text": "Behind the screen: “I won’t put myself there this week.”",
   "if": "s2e10_amend==\"restraint\""
  },
  {
   "text": "Osei: “So tonight I tell you nothing. You know where the door is.”"
  },
  {
   "text": "On the swing, Skye: “I fly Friday morning. Two weeks.” … “Who knows, maybe it’ll be good for you guys.”",
   "if": "s2e10_after==\"porch\""
  },
  {
   "text": "In the Saab, Skye: “I fly Friday morning. Two weeks.” … “Who knows,” … “maybe it’ll be good for you guys.”",
   "if": "s2e10_after!=\"porch\""
  }
 ],
