 "dates": "Saturday, December 26 – Thursday, December 31, 2009",
 "logline": "The week after Christmas on Glenwood Avenue: a television show nobody in the family can stop watching, a father at a bolted table, a phone call at an hour nobody keeps — and midnight three times.",
 "previously": [
  {
   "text": "At Trumbull, your brother: “The twenty-seventh, Ma. All of you.” … “Pop too. Tell him I said.”"
  },
  {
   "text": "On the phone in the basement, Skye: “I’d rather be in your basement.” “It smells like fish.” “Then I’d rather be in your basement with you in it.”"
  },
  {
   "text": "Behind the grille at St. Brigid’s: “God gave you two thousand miles for Christmas. Don’t mail them back.”",
   "if": "confessed_skye_4"
  },
  {
   "text": "From the bottom of a driveway in the hills, Skye: “You’re saying no to a *phone*, Jack.”",
   "if": "!confessed_skye_4"
  },
  {
   "text": "On the levee, Lena: “Julian lands the thirtieth. Mémère’s ironing a tablecloth.”"
  },
  {
   "text": "In the front room at midnight, Nonna: “*Due ragazze.*” … “*Quale ti fa pregare?*”"
  },
  {
   "text": "On the steps after Midnight Mass, Carly Benedetto: “There’s a thing at Ryan’s on New Year’s. YSU people.” … “Come.”",
   "if": "knows_carly_home"
  }
 ],
