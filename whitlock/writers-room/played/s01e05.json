  "path": [
   {
    "at": 1791925478163,
    "c": "c",
    "label": "Take the jug. Drink with him, line for line.",
    "n": "n1"
   },
   {
    "at": 1791925511208,
    "c": "b",
    "label": "‘Can I read the rest when there's a rest?’",
    "n": "n2"
   },
   {
    "at": 1791925562171,
    "c": "a",
    "label": "‘Buddy system. I'll take the Anchor. Augie takes Dot's.’",
    "n": "n3"
   },
   {
    "at": 1791925590087,
    "c": "a",
    "label": "Take out the 1991 ticket. Put it on the counter.",
    "n": "n4"
   },
   {
    "at": 1791925646490,
    "c": "c",
    "label": "Put a fifty on the bar. ‘For the coaster. And the trouble.’",
    "n": "n5"
   },
   {
    "at": 1791925685146,
    "c": "a",
    "label": "‘He sold me a grilled cheese. At Dot's. Great grilled cheese.’",
    "n": "n6"
   },
   {
    "n": "n7"
   },
   {
    "at": 1791925874869,
    "c": "c",
    "label": "‘Go without me. I want to watch her count.’",
    "n": "n8"
   },
   {
    "at": 1791925963041,
    "c": "a",
    "label": "Watch her hands. Say: ‘You don't stop. Ever.’",
    "n": "n8m"
   },
   {
    "at": 1791926041028,
    "c": "a",
    "label": "Stake him. Throw your own chips on the Bank.",
    "n": "n9"
   },
   {
    "at": 1791926072821,
    "c": "b",
    "label": "‘No calls. Then we drive. Give me keys.’",
    "n": "n10",
    "remember": "Brooks will remember you made a deal."
   },
   {
    "at": 1791926105506,
    "c": "a",
    "label": "Hand Margaux your phone. ‘Call 911. Tell them we're coming.’",
    "n": "n11d"
   },
   {
    "at": 1791926159271,
    "c": "c",
    "label": "Sit in the bolted chair. Don't leave until morning.",
    "n": "n12",
    "remember": "Augie will remember who stayed."
   },
   {
    "n": "n13"
   },
   {
    "at": 1791926203529,
    "c": "a",
    "label": "Tell him the number. Exactly.",
    "n": "n14"
   },
   {
    "at": 1791926229209,
    "c": "a",
    "label": "Answer it. Say ‘Dad.’ Out loud.",
    "n": "n15",
    "remember": "Your father heard your voice."
   },
   {
    "at": 1791926278012,
    "c": "c",
    "label": "‘No comment.’ Your father's line.",
    "n": "n16",
    "remember": "Nora will remember your father's line in your mouth."
   },
   {
    "at": 1791926306260,
    "c": "b",
    "label": "‘Five. The roof. Nothing.’ Go to Margaux.",
    "n": "n17",
    "remember": "Augie will remember you didn't come."
   },
   {
    "at": 1791926348546,
    "c": "a",
    "label": "‘Can I see it? The drawing. Right side up.’",
    "n": "n18m",
    "remember": "You've seen the drawings."
   },
   {
    "at": 1791926371515,
    "c": "a",
    "label": "‘Stay for the fireworks. Five minutes. Be late once.’",
    "n": "n19m"
   },
   {
    "at": 1791926571610,
    "c": "a",
    "label": "‘Yes. Six-forty. I'll be on the landing.’",
    "n": "n20"
   },
   {
    "n": "n21"
   }
  ],
